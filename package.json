{
  "name": "@commitspark/git-adapter-filesystem",
  "description": "Adapter that provides filesystem-based repository access to Commitspark",
  "version": "2.0.0-beta.1",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/commitspark/git-adapter-filesystem.git"
  },
  "private": false,
  "files": [
    "dist/**",
    "!dist/**/*.tsbuildinfo",
    "src/**",
    "README.md",
    "LICENSE",
    "package.json",
    "CHANGELOG.md"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "require": "./dist/cjs/index.js",
      "import": "./dist/esm/index.js"
    }
  },
  "scripts": {
    "build": "npm run build:cjs && npm run build:esm && npm run build:types",
    "build:cjs": "tsc --project tsconfig.build.cjs.json",
    "build:esm": "tsc --project tsconfig.build.esm.json && echo '{\"type\":\"module\"}' > dist/esm/package.json",
    "build:types": "tsc --project tsconfig.build.types.json",
    "lint": "eslint \"{src,tests}/**/*.ts\"",
    "test": "jest",
    "knip": "knip",
    "prepublishOnly": "npm run build",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "dependencies": {
    "@commitspark/git-adapter": "^2.0.0-beta.1",
    "yaml": "^2.0.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.14.0",
    "eslint": "^9.24.0",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^16.5.0",
    "jest": "^30.2.0",
    "knip": "^5.46.5",
    "prettier": "^3.1.1",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.29.0"
  }
}
